          },
          "required": [
            "status",
            "tool",
            "reason"
          ],
          "additionalProperties": false
        },
        "static_data": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "analyzed",
                "unavailable",
                "error"
              ]
            },
            "tool": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
