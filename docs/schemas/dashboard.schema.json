{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 2
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "sketch": {
                "type": "string",
                "enum": [
                  "blink",
                  "spi",
                  "rainbow"
                ]
              },
              "board": {
                "type": "string",
                "enum": [
                  "uno",
                  "esp32s3",
                  "esp32dev",
                  "teensy41"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "measured_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "status": {
                "type": "string",
                "const": "ok"
              },
              "flash": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ram": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "image_flash": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attributed_ram": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "protocol": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bloat_report": {
                "type": "string",
                "pattern": "^data\\/reports\\/(uno|esp32s3|esp32dev|teensy41)\\/[a-f0-9]{40}-[a-f0-9]{12}\\.json$"
              },
              "fbuild": {
                "type": "string"
              },
              "serial_symbols": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "toolchain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "defines": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "flags": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "config": {
                "type": "string"
              },
              "elf_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "sketch",
              "board",
              "version",
              "sha",
              "measured_at",
              "status",
              "flash",
              "ram",
              "image_flash",
              "attributed_ram",
              "protocol",
              "source_digest",
              "bloat_report",
              "fbuild",
              "serial_symbols",
              "toolchain",
              "defines",
              "flags",
              "config",
              "elf_digest"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sketch": {
                "type": "string",
                "enum": [
                  "blink",
                  "spi",
                  "rainbow"
                ]
              },
              "board": {
                "type": "string",
                "enum": [
                  "uno",
                  "esp32s3",
                  "esp32dev",
                  "teensy41"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "measured_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "status": {
                "type": "string",
                "const": "error"
              },
              "flash": {
                "type": "null"
              },
              "ram": {
                "type": "null"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "sketch",
              "board",
              "version",
              "sha",
              "measured_at",
              "status",
              "flash",
              "ram",
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fbuild": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "results",
    "updated_at",
    "versions",
    "fbuild"
  ],
  "additionalProperties": false
}
