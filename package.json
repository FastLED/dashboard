{
  "name": "fastled-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --max-warnings 0",
    "format": "prettier --write src scripts tests package.json tsconfig.json eslint.config.js",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "benchmark": "node scripts/benchmark.ts",
    "screenshot": "node scripts/screenshot.ts",
    "test:view": "node --test tests/view.browser.ts",
    "dev": "node scripts/serve.ts",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json eslint.config.js"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "shell-quote": "^1.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/shell-quote": "^1.7.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
